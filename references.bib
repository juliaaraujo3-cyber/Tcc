% ============================================================
%  Referências Bibliográficas – formato BibTeX
%  Norma ABNT NBR 6023:2018 via abntex2cite
% ============================================================
%
%  Tipos mais comuns:
%    @article   → artigo em periódico
%    @book      → livro
%    @inbook    → capítulo de livro
%    @misc      → site/página web
%    @mastersthesis / @phdthesis → dissertação/tese
%
%  Para gerar entradas automaticamente acesse:
%    https://www.doi2bib.org  ou  https://zbib.org
% ============================================================

% ── EXEMPLOS ────────────────────────────────────────────────

@article{sobrenome2020,
  author  = {Sobrenome, Nome and Outro, Autor},
  title   = {Título do artigo científico},
  journal = {Nome do Periódico},
  year    = {2020},
  volume  = {10},
  number  = {2},
  pages   = {100--110},
  doi     = {10.0000/exemplo},
}

@book{autor2019,
  author    = {Autor, Nome},
  title     = {Título do Livro},
  edition   = {3},
  publisher = {Editora},
  address   = {Cidade},
  year      = {2019},
}

@inbook{capitulo2021,
  author    = {Capítulo, Autor do},
  title     = {Título do Capítulo},
  booktitle = {Título do Livro},
  editor    = {Editor, Nome do},
  publisher = {Editora},
  address   = {Cidade},
  year      = {2021},
  pages     = {50--75},
}

@misc{site2023,
  author       = {Organização ou Autor},
  title        = {Título da Página},
  year         = {2023},
  howpublished = {\url{https://www.exemplo.com.br}},
  note         = {Acesso em: 10 jan. 2026},
}

% Substitua os exemplos acima pelas suas referências reais.
